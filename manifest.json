{
  "manifest_version": 3,
  "name": "Hokage Customs Premium тест",
  "version": "1.0",
  "description": "Приватный кастом для форума Black Russia",
  "permissions": ["storage", "unlimitedStorage", "tabs", "activeTab"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://forum.blackrussia.online/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_start"
    }
  ]
}
